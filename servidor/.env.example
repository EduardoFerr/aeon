# Copie para .env (cp .env.example .env), preencha e proteja: chmod 600 .env
NODE_ENV=production

# Gere com: openssl rand -base64 48   (mínimo 32 caracteres; não troque depois, ou os códigos pendentes morrem)
SEGREDO=

# Origens do app que podem falar com a API (separe por vírgula). Sem barra no fim.
ORIGENS_PERMITIDAS=https://aeonfool.com

# E-mail do código de acesso: SMTP da Hostinger (caixa atendimento@aeonfool.com criada no hPanel)
SMTP_HOST=smtp.hostinger.com
SMTP_PORTA=465
SMTP_USUARIO=atendimento@aeonfool.com
# Se a senha tiver aspas simples, ela quebra aqui; use aspas duplas ao redor. Senha entre aspas simples: 'minha senha'
SMTP_SENHA=
EMAIL_DE=atendimento@aeonfool.com
